<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Cristian Pirloaga — software developer. Un colț personal pentru cod, idei și mici unelte utile.">
  <meta name="theme-color" content="#65ada0">
  <title>Parley — Cristian Pirloaga</title>
  <link rel="icon" href="/assets/img/favicon.ico">
  <% for (const stylesheet of it.assets.styles) { %><link rel="stylesheet" href="<%= stylesheet %>"><% } %>
  <script type="module" src="<%= it.assets.script %>"></script>
</head>
<body x-data="shell" data-initial-section="<%= it.initialSection %>" :class="{ 'has-player': $store.radio.station }">
  <%~ include('icons') %>
  <a class="skip-link" href="#main">Sari la conținut</a>
  <div class="ambient-shape shape-one" aria-hidden="true"></div><div class="ambient-shape shape-two" aria-hidden="true"></div>
  <div class="portfolio">
    <nav class="section-nav" aria-label="Secțiuni și utilitare">
      <a class="nav-tab" href="/" data-section="about" aria-label="Prezentare" :aria-current="section === 'about' ? 'page' : null" @click.prevent="openSection('about')" <% if (it.initialSection === 'about') { %>aria-current="page"<% } %>>
        <svg class="icon" aria-hidden="true"><use href="#i-person"/></svg><span>Despre</span>
      </a>
      <% for (const tool of it.tools) { %>
      <a class="nav-tab" href="/?tool=<%= tool.slug %>" data-section="<%= tool.slug %>" aria-label="<%= tool.title %>" :aria-current="section === '<%= tool.slug %>' ? 'page' : null" @click.prevent="openSection('<%= tool.slug %>')" <% if (it.initialSection === tool.slug) { %>aria-current="page"<% } %>>
        <svg class="icon" aria-hidden="true"><use href="#i-<%= tool.icon %>"/></svg><span><%= tool.navTitle %></span><% if (tool.slug === 'radio') { %><span class="radio-live-dot" x-cloak x-show="$store.radio.playing" aria-label="Radioul redă"></span><% } %>
      </a>
      <% } %>
    </nav>
    <aside class="profile-card" aria-label="Profil Cristian Pirloaga">
      <div class="profile-cover"><img class="profile-portrait" src="/assets/img/avatar.jpg" alt="Portret ilustrat al lui Cristian Pirloaga" width="1600" height="1600" fetchpriority="high"><a class="profile-brand" href="/" @click.prevent="openSection('about')" aria-label="Parley — prezentare"><img src="/assets/img/logo-inline.png" alt="Parley" width="124" height="58"></a></div>
      <div class="profile-body">
        <p class="profile-eyebrow">HELLO, WORLD.</p><h1>Cristian Pirloaga</h1><p class="profile-role">Software developer<span class="typing-cursor" aria-hidden="true"></span></p>
        <p class="profile-tagline">Cod. Curiozitate. Un pic de mine.</p>
        <div class="profile-socials"><a href="https://www.linkedin.com/in/cristian-pirloaga-16404ab7/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg class="icon" aria-hidden="true"><use href="#i-linkedin"/></svg></a><a href="https://www.facebook.com/pirloaga.cristian" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg class="icon" aria-hidden="true"><use href="#i-facebook"/></svg></a></div>
      </div>
      <div class="profile-actions">
        <a href="/?section=cv" @click.prevent="openSection('cv')" :aria-current="section === 'cv' ? 'page' : null">Download CV <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg></a>
        <a href="/?section=contact" @click.prevent="openSection('contact')" :aria-current="section === 'contact' ? 'page' : null">Contact me <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </aside>
    <main id="main" class="content-card" tabindex="-1">
      <section id="panel-about" class="content-panel" aria-labelledby="about-title" x-show="section === 'about'" <% if (it.initialSection !== 'about') { %>style="display:none"<% } %>>
        <div class="panel-heading"><h2 id="about-title" class="section-title"><span>Despre</span> mine</h2>
          <form id="language-form" x-data="translation" hx-post="/translate" hx-target="#presentation" hx-swap="innerHTML" hx-trigger="change, submit" hx-sync="this:replace" hx-indicator="#translation-progress"
            @htmx:before-request="begin($event)" @htmx:after-request="finish($event)" @htmx:after-swap="applied()" @translation-error.window="error = $event.detail.message">
            <label class="language-control"><svg class="icon" aria-hidden="true"><use href="#i-globe"/></svg><span class="sr-only">Limba prezentării</span><select name="toLanguage" x-model="selected" aria-label="Limba prezentării"><% for (const [code, name] of it.languages) { %><option value="<%= code %>"><%= name %></option><% } %></select></label>
            <span id="translation-progress" class="htmx-indicator translation-progress" role="status">Se traduce…</span>
            <div class="translation-error" x-cloak x-show="error" role="alert"><span x-text="error"></span><button class="text-button" type="submit">Reîncearcă</button></div>
          </form>
        </div>
        <div id="presentation" aria-live="polite"><%~ include('presentation', it) %></div>
      </section>
      <% for (const tool of it.tools) { %>
      <section id="panel-<%= tool.slug %>" class="content-panel" aria-label="<%= tool.title %>" x-show="section === '<%= tool.slug %>'" <% if (it.initialSection !== tool.slug) { %>style="display:none"<% } %>>
        <div id="content-<%= tool.slug %>" data-loaded="<%= it.initialSection === tool.slug %>"><% if (it.initialSection === tool.slug) { %><%~ it.initialContent %><% } %></div>
      </section>
      <% } %>
      <section id="panel-cv" class="content-panel placeholder-panel" aria-labelledby="cv-title" x-show="section === 'cv'" <% if (it.initialSection !== 'cv') { %>style="display:none"<% } %>>
        <div class="panel-heading"><h2 id="cv-title" class="section-title"><span>Download</span> CV</h2></div>
      </section>
      <section id="panel-contact" class="content-panel placeholder-panel" aria-labelledby="contact-title" x-show="section === 'contact'" <% if (it.initialSection !== 'contact') { %>style="display:none"<% } %>>
        <div class="panel-heading"><h2 id="contact-title" class="section-title"><span>Contact</span> me</h2></div>
      </section>
    </main>
  </div>
  <div class="mini-player" x-cloak x-show="$store.radio.station" role="region" aria-label="Player radio">
    <div class="player-art"><svg class="icon" aria-hidden="true"><use href="#i-radio"/></svg></div>
    <button class="player-details" @click="openSection('radio')"><span class="player-caption" x-text="$store.radio.loading ? 'SE CONECTEAZĂ…' : ($store.radio.playing ? 'ACUM SE AUDE' : 'RADIO')"></span><strong x-text="$store.radio.station?.name"></strong></button>
    <button class="play-button" @click="$store.radio.toggle()" :aria-label="$store.radio.playing ? 'Pauză' : 'Redă postul'"><svg class="icon" aria-hidden="true"><use :href="$store.radio.playing ? '#i-pause' : '#i-play'"/></svg></button>
    <label class="volume-control"><svg class="icon" aria-hidden="true"><use href="#i-volume"/></svg><span class="sr-only">Volum</span><input type="range" min="0" max="1" step="0.05" :value="$store.radio.volume" @input="$store.radio.setVolume($el.value)" aria-label="Volum"></label>
    <button class="icon-button player-open" @click="openSection('radio')" aria-label="Deschide lista de posturi"><svg class="icon"><use href="#i-external"/></svg></button>
    <div class="player-error" x-show="$store.radio.error" role="alert"><span x-text="$store.radio.error"></span><button class="text-button" @click="$store.radio.retry()">Reîncearcă</button></div>
  </div>
  <audio id="radio-audio" preload="none"></audio>
</body>
</html>
