<section class="radio-panel" x-data>
  <span class="tool-icon modal-tool-icon"><svg class="icon" aria-hidden="true"><use href="#i-radio"/></svg></span><p class="eyebrow">MUZICĂ</p><h2 id="modal-title">Pe frecvența ta<span>.</span></h2><p class="modal-description">Alege un post. Muzica rămâne cu tine și după ce închizi fereastra.</p>
  <% if (it.failed) { %><div class="empty-state" role="alert"><p>Nu am putut încărca posturile radio.</p><button class="primary-button" hx-get="/tools/radio" hx-target="#tool-content" hx-swap="innerHTML">Reîncearcă</button></div>
  <% } else if (!it.stations.length) { %><p class="empty-state">Lista de posturi este momentan goală.</p>
  <% } else { %>
  <div class="radio-list"><% for (const station of it.stations) { %>
    <button class="station" type="button" data-id="<%= station.id %>" data-name="<%= station.name %>" data-stream="<%= station.stream %>" @click="$store.radio.choose($el.dataset)" :class="{ active: $store.radio.station?.id === $el.dataset.id }" :aria-pressed="$store.radio.station?.id === $el.dataset.id" <%= !station.stream ? 'disabled' : '' %>>
      <span class="station-logo"><span><%= station.name.slice(0, 2).toUpperCase() %></span><% if (station.logo) { %><img src="<%= station.logo %>" alt="" loading="lazy" referrerpolicy="no-referrer" @error="$el.remove()"><% } %></span><span class="station-name"><strong><%= station.name %></strong><small x-text="$store.radio.station?.id === $el.closest('button').dataset.id && $store.radio.playing ? 'Acum se aude' : 'Radio live'"></small></span><svg class="icon station-play" aria-hidden="true"><use :href="$store.radio.station?.id === $el.closest('button').dataset.id && $store.radio.playing ? '#i-pause' : '#i-play'"/></svg>
    </button>
  <% } %></div>
  <% } %>
  <p class="radio-note"><span class="status-dot"></span> Redarea continuă în mini-player.</p>
</section>
