{
  "name": "parley-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run check && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-views.mjs",
    "check": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "npm run build:server && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "dev": "npm run build && concurrently -k 'tsc -p tsconfig.server.json --watch' 'vite build --watch' 'node --watch dist/src/main.js'"
  },
  "dependencies": {
    "@aws-sdk/client-translate": "^3.1143.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/poppins": "^5.3.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "alpinejs": "^3.17.4",
    "eta": "^4.6.0",
    "fastify": "^5.12.5",
    "htmx.org": "^2.0.11",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
